# Copie para backend/.env (ou para a raiz do projeto como .env)

# Aplicativo Bling (Central de Extensões → Área do Integrador)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# URLs oficiais da API v3 — não altere salvo orientação da Bling
BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://www.bling.com.br/Api/v3/oauth/token
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3

# Endereço desta aplicação (o mesmo host que você cola no
# "Link de redirecionamento" do aplicativo Bling).
# Local: http://127.0.0.1:8000
# Produção: https://seu-dominio.com
# O callback usado é {APP_BASE_URL}/api/bling/callback
APP_BASE_URL=http://127.0.0.1:8000

# Segredo para assinar o state OAuth (qualquer string longa e aleatória)
APP_SECRET=troque-esta-chave

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=bling_robot

# ---------------------------------------------------------------------------
# Inteligência Artificial — use SUA chave (substitui a "Universal Key" da Emergent).
# Basta UMA. Também dá para colar pela tela Configurações → Inteligência Artificial.
#   Anthropic  → textos (padrão Claude Haiku 4.5)       console.anthropic.com
#   OpenAI     → textos, imagens (gpt-image-1) e voz     platform.openai.com
#   Gemini     → textos e imagens "Nano Banana"          aistudio.google.com
#   OpenRouter → uma chave para vários modelos           openrouter.ai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Opcional: forçar provedor/modelo
# AI_TEXT_PROVIDER=anthropic
# AI_TEXT_MODEL=claude-haiku-4-5
# AI_IMAGE_PROVIDER=gemini
# AI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# Senha do painel. Deixe VAZIO no seu PC. Num servidor/VPS na internet,
# defina uma senha forte — sem ela qualquer pessoa com o endereço controla o robô.
APP_PASSWORD=

CORS_ORIGINS=*
