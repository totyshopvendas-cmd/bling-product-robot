# Copie para backend/.env (ou para a raiz do projeto como .env)

# Aplicativo Bling (Central de Extensões → Área do Integrador)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# URLs oficiais da API v3 — não altere salvo orientação da Bling
BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://www.bling.com.br/Api/v3/oauth/token
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3

# Endereço público HTTPS desta aplicação (o mesmo que você cola no
# "Link de redirecionamento" do aplicativo Bling). Ex.:
#   https://seu-dominio.com
# O callback usado é {APP_BASE_URL}/api/bling/callback
APP_BASE_URL=

# Segredo para assinar o state OAuth (qualquer string longa e aleatória)
APP_SECRET=troque-esta-chave

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=bling_robot

# Opcional — LLM (OpenAI). Sem isso, a limpeza de título regex continua funcionando.
OPENAI_API_KEY=

CORS_ORIGINS=*
