# Para ativar o CI: no GitHub, crie o arquivo .github/workflows/ci.yml com este conteúdo.
name: CI

on:
  push:
  pull_request:

jobs:
  backend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
          cache-dependency-path: backend/requirements.txt
      - run: pip install -r requirements.txt pytest
      - name: Compila todos os módulos (pega arquivos corrompidos)
        run: python -m compileall -q .
      - name: Procura marcadores de conflito / trechos truncados
        run: |
          ! grep -rnE '^(<<<<<<<|>>>>>>>)' --include='*.py' --include='*.js' --include='*.jsx' .. --exclude-dir=node_modules
      - run: pytest tests -q
        env:
          MONGO_URL: memory://
          LOCAL_DB_PERSIST: "0"

  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - run: npm install --legacy-peer-deps --no-audit --no-fund
      - run: npm run build
        env:
          CI: "false"
          GENERATE_SOURCEMAP: "false"
